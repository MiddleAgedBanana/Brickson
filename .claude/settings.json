{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__request_copilot_review",
      "mcp__github__assign_copilot_to_issue",
      "mcp__github__create_pull_request_with_copilot"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*__(merge_pull_request|enable_pr_auto_merge|request_copilot_review|assign_copilot_to_issue|create_pull_request_with_copilot|push_files|create_or_update_file|delete_file|pull_request_review_write|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
