# The Xcode project is generated from project.yml (`xcodegen generate`).
*.xcodeproj/

# Xcode build output and per-person state
build/
DerivedData/
*.xcresult
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.moved-aside

# Swift Package Manager (no packages today; harmless if absent)
.build/
.swiftpm/

# Archives, app builds and debug symbols made for a device or an upload
*.xcarchive
*.ipa
*.dSYM
*.dSYM.zip

# A safety net only, not a guarantee: git still adds these files with
# `git add -f`. Keep account notes, receipts and anything sensitive
# outside this public repository; this stops an accidental commit
/private/

# macOS
.DS_Store

# Claude Code: personal settings, worktrees and local state stay on each machine
.claude/settings.local.json
.claude/worktrees/
.remember/

# Agent skills installed per machine (see AGENTS.md, "Skills")
.agents/
.claude/skills/

# Apple's Xcode skills, if exported into the checkout, are Apple's software
# and must never be committed (AGENTS.md, "Skills")
/xcode-skills/
